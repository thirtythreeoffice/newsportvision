# Help Desk — set these in Vercel → Project → Settings → Environment Variables.
# Never put a real key in this file; it is committed to Git.

# Required. From Resend → API Keys. Server-side only: no NEXT_PUBLIC_ or
# similar prefix, and it is read only by api/help-desk.mjs.
RESEND_API_KEY=

# Optional. These are also the built-in defaults.
HELP_DESK_TO_EMAIL=office@newsportvision.com
HELP_DESK_FROM_EMAIL=NewSportVision Help Desk <helpdesk@send.newsportvision.com>
